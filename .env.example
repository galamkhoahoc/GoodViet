# GOODVIET Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
# For local development:
# VITE_API_URL=http://localhost:3000
# For production (Vercel):
VITE_API_URL=https://glkh-good-viet-e1r4ix73b-ilikechickeneverytime-1859s-projects.vercel.app

# Feature Flags
# Set to 'false' to use real backend API
VITE_USE_MOCK_API=false
# Chỉ dùng khi kiểm tra UI local; bị vô hiệu trong production build.
# VITE_DEV_PREVIEW=true

# Browser speech model (repository must include config, preprocessor_config,
# and onnx/model_fp16.onnx + onnx/model_quantized.onnx)
VITE_VOICE_MODEL_ID=tuanio/wav2vec2-base-finetune-vi_phone-non_freeze-spec_aug-500epoch
# Prefer an immutable commit SHA after publishing the ONNX artifacts
VITE_VOICE_MODEL_REVISION=main

# Gemma 4 E2B QAT Mobile chạy bằng WebGPU. Runtime mặc định được khóa vào
# một commit của demo webml-community; chỉ đổi khi đã kiểm thử phiên bản mới.
# VITE_GEMMA_RUNTIME_URL=/ai-runtime/gemma-4-e2b.js

# EraX CT2 không chạy trực tiếp trong browser. Xuất checkpoint Transformers gốc
# bằng tools/erax-browser-model/export_erax_model.ps1, upload output lên một
# repository model rồi điền ID/revision bất biến tại đây.
VITE_ERAX_BROWSER_MODEL_ID=
VITE_ERAX_MODEL_REVISION=main
# wasm tiết kiệm VRAM khi Gemma đang dùng WebGPU; có thể đổi thành webgpu trên máy mạnh.
VITE_ERAX_DEVICE=wasm

# Error Tracking (optional)
# VITE_SENTRY_DSN=
