# GOODVIET Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
# For local development:
# VITE_API_URL=http://localhost:3000
# For production (Vercel):
VITE_API_URL=https://glkh-good-viet-e1r4ix73b-ilikechickeneverytime-1859s-projects.vercel.app

# Feature Flags
# Set to 'false' to use real backend API
VITE_USE_MOCK_API=false

# Browser speech model (repository must include config, preprocessor_config,
# and onnx/model_fp16.onnx + onnx/model_quantized.onnx)
VITE_VOICE_MODEL_ID=tuanio/wav2vec2-base-finetune-vi_phone-non_freeze-spec_aug-500epoch
# Prefer an immutable commit SHA after publishing the ONNX artifacts
VITE_VOICE_MODEL_REVISION=main

# Error Tracking (optional)
# VITE_SENTRY_DSN=
