# ==============================================================================
# Flask Server Configuration
# ==============================================================================
# Port for Flask HTTP server
# Default: 5000 (must not conflict with Node.js backend on port 3000)
# Requirements: 6.7
PORT=5000

# Enable Flask debug mode (set to 'false' in production)
FLASK_DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Allowed origins for CORS (comma-separated list)
# Must include Node.js backend URL
# Requirements: 6.6
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# Gemma 4 Model Configuration
# ==============================================================================
# Target model (main inference model)
# Options:
#   - google/gemma-4-e2b (2B parameters, supports audio + image)
#   - google/gemma-4-e4b (4B parameters, supports audio + image + video)
# Default: google/gemma-4-e2b
# Requirements: 2.3
GEMMA4_TARGET_MODEL=google/gemma-4-e2b

# Assistant model (for speculative decoding)
# Options:
#   - google/gemma-4-1b (1B parameters, fast draft model)
#   - google/gemma-4-e2b-it-assistant (optimized assistant)
# Default: google/gemma-4-1b
# Requirements: 2.3
GEMMA4_ASSISTANT_MODEL=google/gemma-4-1b

# Device selection
# Options:
#   - 'auto': Automatically detect (CUDA if available, else CPU)
#   - 'cuda': Force CUDA GPU (recommended for production)
#   - 'cpu': Force CPU (slower, only for development/testing)
# Default: auto
# Requirements: 2.4, 2.5
GEMMA4_DEVICE=auto

# Model variant (determines multi-modal capabilities)
# Options:
#   - 'e2b': Supports audio + image (2B model)
#   - 'e4b': Supports audio + image + video (4B model)
# Must match the TARGET_MODEL variant
# Default: e2b
# Requirements: 10.6
GEMMA4_MODEL_VARIANT=e2b

# ==============================================================================
# Generation Parameters
# ==============================================================================
# Temperature for sampling (higher = more creative, lower = more focused)
# Recommended: 1.0 (per Gemma 4 best practices)
# Range: 0.0 to 2.0
# Requirements: 2.3
TEMPERATURE=1.0

# Top-p (nucleus sampling threshold)
# Recommended: 0.95 (per Gemma 4 best practices)
# Range: 0.0 to 1.0
# Requirements: 2.3
TOP_P=0.95

# Top-k (number of highest probability tokens to consider)
# Recommended: 64 (per Gemma 4 best practices)
# Range: 1 to 100
# Requirements: 2.3
TOP_K=64

# Maximum new tokens to generate
# Default: 256 (adjust based on use case)
# Requirements: 2.3
MAX_NEW_TOKENS=256

# ==============================================================================
# Speculative Decoding Configuration
# ==============================================================================
# Number of tokens to lookahead in speculative decoding
# Higher values = more speedup but more memory usage
# Recommended: 5
# Range: 3 to 10
# Requirements: 8.1, 8.2
SPECULATIVE_LOOKAHEAD=5

# ==============================================================================
# Performance Configuration
# ==============================================================================
# Request timeout in seconds
# Default: 30
REQUEST_TIMEOUT=30

# Enable model warming on startup (loads models into memory)
# Recommended: true for production
ENABLE_MODEL_WARMING=true
