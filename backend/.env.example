# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS Origin
CORS_ORIGIN=http://localhost:5173

# AWS S3 (Optional - configure when ready)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=goodviet-audio

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# AI Service Configuration
# ==============================================================================
# Select which AI service to use for chat and audio analysis
# Options: 
#   - 'gemma4': Gemma 4 via Python bridge (best quality, requires Python service)
#   - 'ollama': Local Gemma 2B via Ollama (good quality, runs locally)
#   - 'gemini': Google Gemini API (fallback, requires API key)
# Leave empty for auto-detect (tries Gemma4 → Ollama → Gemini)
# Requirements: 6.1, 6.6
AI_SERVICE=gemma4

# ==============================================================================
# Gemma 4 Python Bridge Configuration
# ==============================================================================
# Python AI service host URL
# Default: http://localhost:5000
# Requirements: 6.6
GEMMA4_HOST=http://localhost:5000

# Request timeout in milliseconds (30 seconds recommended)
# Default: 30000
# Requirements: 6.6
GEMMA4_TIMEOUT=30000

# ==============================================================================
# Ollama Configuration (Fallback)
# ==============================================================================
# Ollama service host URL (used as fallback if Gemma4 is unavailable)
OLLAMA_HOST=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=gemma:2b
